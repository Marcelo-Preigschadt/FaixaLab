{
  "name": "FaixaLab · CPU na nuvem",
  "features": {"ghcr.io/devcontainers/features/python:1": {"version": "3.12"}},
  "hostRequirements": {"cpus": 2, "memory": "8gb", "storage": "32gb"},
  "forwardPorts": [7860],
  "portsAttributes": {"7860": {"label": "FaixaLab", "onAutoForward": "notify", "protocol": "http"}},
  "remoteEnv": {"FAIXALAB_DATA_DIR": "/workspaces/.faixalab-data", "FAIXALAB_CPU_THREADS": "2"},
  "postCreateCommand": "bash cloud/install.sh",
  "postStartCommand": "bash cloud/start.sh",
  "waitFor": "postCreateCommand",
  "customizations": {"vscode": {"settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/app/.runtime/venv/bin/python"}}}
}
